{
  "name": "pdf-atolyesi",
  "productName": "PDF Atolyesi",
  "version": "2.5.4",
  "description": "Tarayicida degil, masaustunde yerel ve guvenli PDF duzenleyici",
  "main": "main.js",
  "author": "PDF Atolyesi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@tesseract.js-data/tur": "^1.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pdfatolyesi.app",
    "productName": "PDF Atolyesi",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "index.html",
      "app.js",
      "ocr.js",
      "style.css",
      "icon.svg",
      "package.json",
      "build/icon.png",
      "!node_modules/@tesseract.js-data/tur/4.0.0_*/**",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders}/**",
      "!node_modules/pdfjs-dist/build/*.map",
      "!node_modules/pdfjs-dist/build/pdf.js",
      "!node_modules/pdfjs-dist/build/pdf.worker.js",
      "!node_modules/canvas/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "PDF-Atolyesi-${version}-portable.exe"
    }
  }
}
